{
  "folders": [
    {
      "path": "../../.config/dotfiles",
      "name": "dotfiles"
    },
    {
      "path": "../../.config/dotfiles-private",
      "name": "dotfiles-private"
    },
    {
      "path": "general",
      "name": "general"
    },
    {
      "path": "important",
      "name": "important"
    },
    {
      "path": "oss",
      "name": "oss"
    }
  ],
  "settings": {
    "nix.serverSettings": {
      "nixd": {
        "formatting": {
          "command": [
            "nixfmt"
          ]
        },
        "nixpkgs": {
          "expr": "import (builtins.getFlake \"${workspaceFolder:dotfiles}\").inputs.nixpkgs { }"
        },
        "options": {
          "home-manager": {
            "expr": "(builtins.getFlake \"${workspaceFolder:dotfiles}\").darwinConfigurations.macbook-pro-m4-together.options.home-manager.users.type.getSubOptions []"
          },
          "nix-darwin": {
            "expr": "(builtins.getFlake \"${workspaceFolder:dotfiles}\").darwinConfigurations.macbook-pro-m4-together.options"
          }
        }
      }
    },
    "python-envs.workspaceSearchPaths": [
      "./**/.venv"
    ]
  }
}
